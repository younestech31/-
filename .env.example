NEXT_PUBLIC_SITE_URL=https://lattab.vercel.app
INDEXNOW_KEY="your_indexnow_key_here"
CRON_SECRET="your_shared_cron_secret"
DEPLOY_HOOK_SECRET="your_deploy_hook_secret_here"

# Google Indexing API
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Ahrefs Analytics Key
NEXT_PUBLIC_AHREFS_KEY="your_ahrefs_key_here"
# Optional: Webhook for appointment notifications (Make.com, Zapier, n8n, etc.)
NOTIFY_WEBHOOK_URL=

# PDF Export Authentication
PDF_EXPORT_SECRET="your_pdf_export_secret_here"
# PDF_EXPORT_SECRET="your_pdf_export_secret_here"
# ↑ NE PAS préfixer avec NEXT_PUBLIC_ — ce secret ne doit JAMAIS être
#   exposé au client. Utiliser uniquement dans les API Routes côté serveur.

# Firebase Client Configuration (Next.js)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

